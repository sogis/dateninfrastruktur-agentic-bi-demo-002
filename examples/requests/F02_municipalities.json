{
  "period": {
    "from_year": 2025,
    "to_year": 2025
  },
  "group_by": [
    "municipality"
  ],
  "outputs": [
    {
      "id": "people",
      "expr": {
        "kind": "aggregate",
        "metric": "population.count"
      }
    },
    {
      "id": "vehicles",
      "expr": {
        "kind": "aggregate",
        "metric": "vehicles.count"
      }
    }
  ],
  "limit": 1000
}
